{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MinecraftMod mod metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "developer",
    "type",
    "source",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1200
    },
    "developer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "const": "hmod"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "game_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
