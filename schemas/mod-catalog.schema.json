{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Geko7490/MinecraftMod/main/schemas/mod-catalog.schema.json",
  "title": "MinecraftMod catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated",
    "mods"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "mods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mod"
      }
    }
  },
  "$defs": {
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "developer",
        "type",
        "source",
        "versions",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1200
        },
        "developer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "const": "hmod"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "SPDX license identifier."
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "game_versions",
        "download_url",
        "file_name",
        "size",
        "sha256",
        "published",
        "api",
        "side",
        "capabilities"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "game_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "download_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Geko7490/MinecraftMod/releases/download/"
        },
        "file_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.hmod$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "published": {
          "type": "string",
          "format": "date-time"
        },
        "changelog": {
          "type": "string"
        },
        "api": {
          "type": "string",
          "enum": [
            "0.1",
            "0.2",
            "0.3"
          ]
        },
        "side": {
          "type": "string",
          "enum": [
            "client",
            "server",
            "both"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "game-read",
              "chat",
              "hud",
              "storage",
              "command",
              "registries",
              "ui",
              "render",
              "input",
              "players",
              "world",
              "recipes"
            ]
          }
        }
      }
    }
  }
}
